<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_payment_partner_type_filter"
            model="ir.ui.view">

        <field name="name">
            account.payment.partner.type.filter
        </field>

        <field name="model">account.payment</field>

        <field name="inherit_id"
               ref="account.view_account_payment_form"/>

        <field name="arch" type="xml">

            <!-- Customer Payment -->
            <xpath expr="//field[@name='partner_id'][@invisible=&quot;partner_type != 'customer'&quot;]"
                   position="attributes">

                <attribute name="domain">
                    [('customer_rank', '>', 0)]
                </attribute>

                <attribute name="context">
                    {'res_partner_search_mode': 'customer'}
                </attribute>

            </xpath>

            <!-- Vendor Payment -->
            <xpath expr="//field[@name='partner_id'][@invisible=&quot;partner_type != 'supplier'&quot;]"
                   position="attributes">

                <attribute name="domain">
                    [('supplier_rank', '>', 0)]
                </attribute>

                <attribute name="context">
                    {'res_partner_search_mode': 'supplier'}
                </attribute>

            </xpath>

        </field>
    </record>

</odoo>