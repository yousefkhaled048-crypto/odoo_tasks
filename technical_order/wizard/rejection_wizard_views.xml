<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="technical_order_rejection_wizard_view_form" model="ir.ui.view">
        <field name="name">technical.order.rejection.wizard.form</field>
        <field name="model">technical.order.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Technical Order">
                <group>
                    <field name="technical_order_id" invisible="1"/>
                    <field name="rejection_reason" placeholder="Explain why this order is rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>