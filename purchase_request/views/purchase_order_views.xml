<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Purchase Order form: smart button + linked request next to the source document -->
    <record id="view_purchase_order_form_inherit_purchase_request" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.purchase.request</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_request" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not purchase_request_id">
                    <field name="purchase_request_id" widget="statinfo" string="Purchase Request"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="purchase_request_id" readonly="1" invisible="not purchase_request_id"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order list: optionally show the source request -->
    <record id="view_purchase_order_list_inherit_purchase_request" model="ir.ui.view">
        <field name="name">purchase.order.list.inherit.purchase.request</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="purchase_request_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>