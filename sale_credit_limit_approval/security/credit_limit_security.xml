<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_credit_limit" model="res.groups.privilege">
        <field name="name">Credit Limit Approval</field>
        <field name="sequence">2</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="description">Approve Sales Orders subject to a customer credit limit (Approve 1 and Approve 2) and maintain customer credit limits.</field>
    </record>

    <record id="group_credit_limit_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_credit_limit"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="comment">The user can perform both credit approval stages (Approve 1 and Approve 2), reject approvals and edit partner credit limits.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
