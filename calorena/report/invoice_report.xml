<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="paperformat_sale_invoice_simple" model="report.paperformat">
        <field name="name">Sale Invoice Simple</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_spacing">0</field>
    </record>

    <record id="action_report_sale_invoice_simple" model="ir.actions.report">
        <field name="name">Invoice PDF</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">calorena.report_sale_invoice_simple</field>
        <field name="report_file">calorena.report_sale_invoice_simple</field>
        <field name="print_report_name">'Invoice - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_sale_invoice_simple"/>
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>