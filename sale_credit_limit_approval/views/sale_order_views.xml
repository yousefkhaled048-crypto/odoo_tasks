<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Sales Order form: credit banner, approval buttons, audit info -->
    <!-- ============================================================ -->
    <record id="view_order_form_credit_limit" model="ir.ui.view">
        <field name="name">sale.order.form.credit.limit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Approval buttons, placed before the Confirm buttons -->
            <xpath expr="//header/button[@id='action_confirm']" position="before">
                <button name="action_credit_request_approval"
                        type="object"
                        string="Request Approval"
                        class="btn-primary"
                        invisible="not credit_can_request"/>
                <button name="action_credit_approve_1"
                        type="object"
                        string="Approve 1"
                        class="btn-primary"
                        groups="sale_credit_limit_approval.group_credit_limit_approver"
                        invisible="not credit_can_approve_1"/>
                <!-- Visible but disabled when the order is within the limit -->
                <button string="Approve 1"
                        class="btn-secondary"
                        disabled="1"
                        title="Not needed: the order is within the credit limit"
                        groups="sale_credit_limit_approval.group_credit_limit_approver"
                        invisible="not credit_show_approve_1_disabled"/>
                <button name="action_credit_approve_2"
                        type="object"
                        string="Approve 2"
                        class="btn-primary"
                        groups="sale_credit_limit_approval.group_credit_limit_approver"
                        invisible="not credit_can_approve_2"/>
                <button name="action_credit_reject"
                        type="object"
                        string="Reject"
                        confirm="Reject the credit approval of this order?"
                        groups="sale_credit_limit_approval.group_credit_limit_approver"
                        invisible="not credit_can_reject"/>
                <button name="action_credit_reset_approval"
                        type="object"
                        string="Reset Approval"
                        invisible="not credit_can_reset"/>
            </xpath>

            <!-- Confirm is only offered once the credit approval is complete
                 (the backend enforces the same rule in _confirmation_error_message) -->
            <xpath expr="//header/button[@id='action_confirm']" position="attributes">
                <attribute name="invisible" add="credit_confirm_blocked" separator="or"/>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm'][not(@id)]" position="attributes">
                <attribute name="invisible" add="credit_confirm_blocked" separator="or"/>
            </xpath>

            <!-- Credit banner at the top of the form -->
            <xpath expr="//header" position="after">
                <field name="credit_check_required" invisible="1"/>
                <field name="credit_currency_id" invisible="1"/>

                <!-- Within limit: green -->
                <div class="alert alert-success mb-0"
                     role="status"
                     invisible="not credit_check_required or credit_status != 'within'">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <i class="fa fa-check-circle" role="img" title="Within Limit"/>
                        <strong>Credit Status:</strong>
                        <field name="credit_status"
                               widget="badge"
                               decoration-success="credit_status == 'within'"
                               decoration-danger="credit_status == 'exceeded'"/>
                        <span class="ms-md-3"><strong>Approval:</strong></span>
                        <field name="credit_approval_state"
                               widget="badge"
                               decoration-muted="credit_approval_state in ('draft', 'cancelled')"
                               decoration-warning="credit_approval_state in ('waiting_1', 'waiting_2')"
                               decoration-success="credit_approval_state == 'approved'"
                               decoration-danger="credit_approval_state == 'rejected'"/>
                    </div>
                    <div class="row g-2">
                        <div class="col-6 col-md">
                            <div class="small">Credit Limit</div>
                            <field name="credit_limit_amount" class="fw-bold"/>
                        </div>
                        <div class="col-6 col-md">
                            <div class="small">Outstanding Invoices</div>
                            <field name="credit_outstanding_amount" class="fw-bold"/>
                        </div>
                        <div class="col-6 col-md">
                            <div class="small">Available Credit</div>
                            <field name="credit_available_amount" class="fw-bold"/>
                        </div>
                        <div class="col-6 col-md">
                            <div class="small">Current Quotation Amount</div>
                            <field name="credit_order_amount" class="fw-bold"/>
                        </div>
                        <div class="col-6 col-md">
                            <div class="small">Potential Exposure</div>
                            <field name="credit_exposure_amount" class="fw-bold"/>
                        </div>
                    </div>
                    <div class="small mt-2">
                        <field name="credit_next_step"/>
                    </div>
                </div>

                <!-- Exceeded limit: red -->
                <div class="alert alert-danger mb-0"
                     role="alert"
                     invisible="not credit_check_required or credit_status != 'exceeded'">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <i class="fa fa-exclamation-triangle" role="img" title="Exceeded Limit"/>
                        <strong>Credit Status:</strong>
                        <field name="credit_status"
                               widget="badge"
                               decoration-success="credit_status == 'within'"
                               decoration-danger="credit_status == 'exceeded'"/>
                        <span class="ms-md-3"><strong>Approval:</strong></span>
                        <field name="credit_approval_state"
                               widget="badge"
                               decoration-muted="credit_approval_state in ('draft', 'cancelled')"
                               decoration-warning="credit_approval_state in ('waiting_1', 'waiting_2')"
                               decoration-success="credit_approval_state == 'approved'"
                               decoration-danger="credit_approval_state == 'rejected'"/>
                    </div>
                    <div class="row g-2">
                        <div class="col-6 col-md">
                            <div class="small">Credit Limit</div>
                            <field name="credit_limit_amount" class="fw-bold"/>
                        </div>
                        <div class="col-6 col-md">
                            <div class="small">Outstanding Invoices</div>
                            <field name="credit_outstanding_amount" class="fw-bold"/>
                        </div>
                        <div class="col-6 col-md">
                            <div class="small">Available Credit</div>
                            <field name="credit_available_amount" class="fw-bold"/>
                        </div>
                        <div class="col-6 col-md">
                            <div class="small">Current Quotation Amount</div>
                            <field name="credit_order_amount" class="fw-bold"/>
                        </div>
                        <div class="col-6 col-md">
                            <div class="small">Potential Exposure</div>
                            <field name="credit_exposure_amount" class="fw-bold"/>
                        </div>
                    </div>
                    <div class="small mt-2">
                        <field name="credit_next_step"/>
                    </div>
                </div>
            </xpath>

            <!-- Audit trail of the approval in the Other Info tab -->
            <xpath expr="//page[@name='other_information']//group[@name='sale_reporting']" position="after">
                <group name="credit_approval_info"
                       string="Credit Approval"
                       invisible="credit_approval_state == 'draft' and not credit_check_required">
                    <field name="credit_approval_state"/>
                    <field name="credit_approver_1_id" invisible="not credit_approver_1_id"/>
                    <field name="credit_approval_1_date" invisible="not credit_approval_1_date"/>
                    <field name="credit_approver_2_id" invisible="not credit_approver_2_id"/>
                    <field name="credit_approval_2_date" invisible="not credit_approval_2_date"/>
                    <field name="credit_approved_amount" invisible="not credit_approver_2_id"/>
                    <field name="credit_rejected_by_id" invisible="not credit_rejected_by_id"/>
                    <field name="credit_rejection_date" invisible="not credit_rejection_date"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- List: approval status badge                                  -->
    <!-- ============================================================ -->
    <record id="sale_order_tree_credit_limit" model="ir.ui.view">
        <field name="name">sale.order.list.credit.limit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="credit_approval_state"
                       widget="badge"
                       optional="show"
                       invisible="credit_approval_state == 'draft'"
                       decoration-warning="credit_approval_state in ('waiting_1', 'waiting_2')"
                       decoration-success="credit_approval_state == 'approved'"
                       decoration-danger="credit_approval_state == 'rejected'"
                       decoration-muted="credit_approval_state == 'cancelled'"/>
            </field>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Search: approval filters                                     -->
    <!-- ============================================================ -->
    <record id="view_sales_order_filter_credit_limit" model="ir.ui.view">
        <field name="name">sale.order.search.credit.limit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter name="credit_pending_approval"
                        string="Pending Credit Approval"
                        domain="[('state', 'in', ('draft', 'sent')),
                                 ('partner_id.commercial_partner_id.partner_limit', '=', True),
                                 ('credit_approval_state', 'in', ('draft', 'waiting_1', 'waiting_2'))]"/>
                <filter name="credit_waiting_approval_1"
                        string="Waiting for Approval 1"
                        domain="[('credit_approval_state', '=', 'waiting_1')]"/>
                <filter name="credit_waiting_approval_2"
                        string="Waiting for Approval 2"
                        domain="[('credit_approval_state', '=', 'waiting_2')]"/>
                <filter name="credit_approved"
                        string="Credit Approved"
                        domain="[('credit_approval_state', '=', 'approved')]"/>
                <filter name="credit_rejected"
                        string="Credit Rejected"
                        domain="[('credit_approval_state', '=', 'rejected')]"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Approvers' menu                                              -->
    <!-- ============================================================ -->
    <record id="action_credit_approval_orders" model="ir.actions.act_window">
        <field name="name">Credit Approvals</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sale.view_quotation_tree"/>
        <field name="search_view_id" ref="sale.view_sales_order_filter"/>
        <field name="context">{'search_default_credit_pending_approval': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No quotation is waiting for a credit approval.</p>
            <p>Quotations of customers with a credit check appear here until they are approved.</p>
        </field>
    </record>

    <menuitem id="menu_credit_approval_orders"
              name="Credit Approvals"
              parent="sale.sale_order_menu"
              action="action_credit_approval_orders"
              groups="sale_credit_limit_approval.group_credit_limit_approver"
              sequence="15"/>

</odoo>
