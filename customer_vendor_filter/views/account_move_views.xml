<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_move_form_partner_type_filter"
            model="ir.ui.view">

        <field name="name">account.move.partner.type.filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']"
                   position="attributes">

                <attribute name="domain">
                    [('customer_rank', '>', 0)] if move_type in ('out_invoice', 'out_refund', 'out_receipt') else [('supplier_rank', '>', 0)]
                </attribute>

            </xpath>

        </field>
    </record>

</odoo>
