<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer Invoices + Vendor Bills -->
    <record id="view_move_form_inherit_analytic_amount" model="ir.ui.view">
        <field name="name">account.move.form.analytic.distribution.amount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='analytic_distribution']" position="after">
                <field name="analytic_distribution_amount"
                       column_invisible="True"
                       force_save="1"
                       groups="analytic.group_analytic_accounting"/>
            </xpath>
        </field>
    </record>
</odoo>
