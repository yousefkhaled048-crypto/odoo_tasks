<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_order_form_custom_lines" model="ir.ui.view">
        <field name="name">sale.order.form.custom.lines</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_print_invoice_pdf" type="object"
                        string="PDF" class="btn-secondary"/>
                <button name="action_export_invoice_excel" type="object"
                        string="EXCEL" class="btn-secondary"/>
            </xpath>

            <!-- Replace Order Lines List -->
            <xpath expr="//field[@name='order_line']/list" position="replace">
                <list string="Order Lines" editable="bottom" default_order="sequence,id">

                    <!-- Add Product -->
                    <control>
                        <create string="Add a product"/>
                        <create string="Add a section"
                                context="{'default_display_type': 'line_section'}"/>
                        <create string="Add a note"
                                context="{'default_display_type': 'line_note'}"/>
                    </control>

                    <!-- 1. Item No -->
                    <field name="item_no" string="Item No" readonly="1"/>

                    <!-- 2. Barcode No -->
                    <field name="barcode_no" string="Barcode No" readonly="1"/>

                    <!-- 3. Item Name -->
                    <field name="product_id" string="Item Name" required="1"/>

                    <!-- 4. Unit -->
                    <field name="product_uom_id" string="Unit"/>

                    <!-- 5. QTY -->
                    <field name="product_uom_qty" string="QTY"/>

                    <!-- 6. Tests -->
                    <field name="tests" string="Tests"/>

                    <!-- 7. Unit Price -->
                    <field name="price_unit" string="Unit Price"/>

                    <!-- 8. D1 -->
                    <field name="discount_1" string="D1"/>

                    <!-- 9. D2 -->
                    <field name="discount_2" string="D2"/>

                    <!-- 10. Final Discount % (auto-calculated from D1 and D2) -->
                    <field name="discount" string="Disc.%" readonly="1"/>

                    <!-- 11. EXCL VAT -->
                    <field name="price_subtotal" string="EXCL VAT" readonly="1"/>

                    <!-- 12. VAT 15% -->
                    <field name="vat_amount" string="VAT 15%" readonly="1"/>

                    <!-- 13. Amount -->
                    <field name="amount_with_vat" string="Amount" readonly="1"/>

                    <!-- Technical Fields -->
                    <field name="sequence" column_invisible="True"/>
                    <field name="display_type" column_invisible="True"/>
                    <field name="company_id" column_invisible="True"/>
                    <field name="currency_id" column_invisible="True"/>

                </list>
            </xpath>

            <!-- Hide Odoo's default totals (they ignore the custom VAT fields) -->
            <xpath expr="//field[@name='tax_totals']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Custom order totals -->
            <xpath expr="//group[@name='sale_total']" position="inside">
                <field name="custom_untaxed_total" string="Total Before VAT"/>
                <field name="custom_vat_total" string="Total VAT 15%"/>
                <field name="custom_grand_total" string="Grand Total"
                       class="oe_subtotal_footer_separator"/>
            </xpath>

        </field>
    </record>

</odoo>