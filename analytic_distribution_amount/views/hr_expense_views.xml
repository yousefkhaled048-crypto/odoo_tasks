<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expense form (main Expenses screen) -->
    <record id="hr_expense_view_form_inherit_analytic_amount" model="ir.ui.view">
        <field name="name">hr.expense.form.analytic.distribution.amount</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='analytic_distribution']" position="attributes">
                <attribute name="options">{'product_field': 'product_id', 'account_field': 'account_id', 'business_domain': 'expense', 'amount_field': 'untaxed_amount_currency'}</attribute>
            </xpath>
            <xpath expr="//field[@name='analytic_distribution']" position="after">
                <field name="untaxed_amount_currency" invisible="1"/>
                <field name="analytic_distribution_amount" invisible="1"
                       groups="analytic.group_analytic_accounting"/>
            </xpath>
        </field>
    </record>

    <!-- Expenses list (My Expenses / Expenses Analysis) -->
    <record id="hr_expense_list_inherit_analytic_amount" model="ir.ui.view">
        <field name="name">hr.expense.list.analytic.distribution.amount</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='analytic_distribution']" position="attributes">
                <attribute name="options">{'product_field': 'product_id', 'business_domain': 'expense', 'amount_field': 'untaxed_amount_currency'}</attribute>
            </xpath>
            <xpath expr="//list//field[@name='analytic_distribution']" position="after">
                <field name="untaxed_amount_currency" column_invisible="True"/>
                <field name="analytic_distribution_amount"
                       column_invisible="True"
                       force_save="1"
                       groups="analytic.group_analytic_accounting"/>
            </xpath>
        </field>
    </record>
</odoo>